{
  "name": "vinyl-vault-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Vinyl Vault: vinyl collections, community, classifieds and messaging.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
