    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --require ./tests/setup.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isabelaohanadev/vinyl-vault.git",
