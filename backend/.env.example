# Copy to .env and adjust: cp .env.example .env
# The API validates these on startup and refuses to boot if something is wrong.

NODE_ENV=development
PORT=3000

# --- MySQL -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=vinyl
DB_PASSWORD=vinyl
DB_NAME=vinylvault
DB_POOL_SIZE=10
# Managed MySQL (Aiven, TiDB Cloud...) only accepts TLS. Set DB_SSL=true and, when the
# provider's CA is not a public one, paste its PEM into DB_SSL_CA.
DB_SSL=false
DB_SSL_CA=

# --- Auth ------------------------------------------------------------------
# Required, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Web -------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:5173
# Used to build the link in password-recovery e-mails.
FRONTEND_URL=http://localhost:5173
JSON_LIMIT=5mb
# Number of reverse proxies in front of the API (0 = none). Needed for correct
# client IPs in rate limiting when deployed behind nginx, Render, Railway, etc.
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

# --- E-mail (Gmail SMTP) ---------------------------------------------------
# Use a Google "App Password", never your real password. Optional in
# development (e-mails are printed to the console), required in production.
EMAIL_USER=
EMAIL_PASS=
# Where the in-app feedback form is delivered.
FEEDBACK_TO=
