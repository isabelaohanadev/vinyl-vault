# Used by docker-compose (the API and the frontend have their own .env.example).
# Copy to .env:  cp .env.example .env

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=

# Public address of the app: used for CORS and for the link in recovery e-mails.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Database credentials for the MySQL container (change them if the port is exposed beyond localhost).
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=vinyl
MYSQL_PORT=3307

# development: e-mails are printed to the backend log. production: needs the SMTP settings below.
NODE_ENV=development
EMAIL_USER=
EMAIL_PASS=
FEEDBACK_TO=
