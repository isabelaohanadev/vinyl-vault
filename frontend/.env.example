# Optional. Leave unset to call the API on the same origin ("/api"), which works
# with the Vite dev proxy and with the nginx image. Set it only when the API is
# hosted on another domain (then add that frontend origin to CORS_ORIGIN).
# VITE_API_URL=https://api.example.com/api

# Dev server only: where the /api proxy points. Defaults to http://localhost:3000.
# VITE_DEV_API_TARGET=http://localhost:3000
