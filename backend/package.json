  },
  "keywords": [
    "vinyl",
    "music",
    "collection",
    "express",
    "mysql"
  ],
  "author": "Isabela Ohana",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/isabelaohanadev/vinyl-vault/issues"
  },
  "homepage": "https://github.com/isabelaohanadev/vinyl-vault#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.18.2",
    "nodemailer": "^10.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
